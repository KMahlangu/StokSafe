@using StokSafe.Models.Enums
@model IEnumerable<StokSafe.Models.Fine>
@{
    ViewData["Title"] = "Manage Fines";
}
<div class="container mt-4">
    <h1 class="fw-bold mb-4"><i class="bi bi-exclamation-triangle"></i> All Club Fines</h1>
    <div class="card shadow-sm border-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Member</th>
                    <th>Type</th>
                    <th>Date Issued</th>
                    <th class="text-end">Balance</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fine in Model)
                {
                    <tr>
                        <td>@(fine.ClubMember?.User?.Name) @(fine.ClubMember?.User?.Surname)</td>
                        <td>@fine.FineType</td>
                        <td>@fine.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td class="text-end fw-bold text-danger">R @fine.Balance.ToString("N2")</td>
                        <td><span class="badge bg-secondary">@fine.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>