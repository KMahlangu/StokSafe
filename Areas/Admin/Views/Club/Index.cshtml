@model IEnumerable<StokSafe.Models.Club>
@{
    ViewData["Title"] = "Manage Clubs";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Manage Clubs</h2>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show">@success<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show">@error<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="row">
        <!-- Create Club Form -->
        <div class="col-md-4 mb-4">
            <div class="premium-card p-4">
                <h5 class="mb-3">Create a New Club</h5>
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Club Name</label>
                        <input type="text" name="name" class="form-control" required placeholder="e.g. Main Stokvel" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description (Optional)</label>
                        <textarea name="description" class="form-control" rows="2"></textarea>
                    </div>
                    <button type="submit" class="btn btn-accent w-100">Create Club</button>
                </form>
            </div>
        </div>

        <!-- List of Clubs -->
        <div class="col-md-8">
            <div class="premium-card p-0 overflow-hidden">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Club Name</th>
                            <th>Description</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var club in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@club.Name</td>
                                    <td class="text-muted">@club.Description</td>
                                    <td>@club.CreatedAt.ToString("yyyy-MM-dd")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="3" class="text-center text-muted p-4">No clubs exist yet. Create one to get started.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>