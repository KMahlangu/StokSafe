@using StokSafe.Models.Enums
@model IEnumerable<StokSafe.Models.Contribution>
@{
    ViewData["Title"] = "View Contributions";
}
<div class="container mt-4">
    <h1 class="fw-bold mb-4"><i class="bi bi-wallet2"></i> All Member Contributions</h1>
    <div class="card shadow-sm border-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Member</th>
                    <th>Week</th>
                    <th>Date</th>
                    <th class="text-end">Amount</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@(c.ClubMember?.User?.Name) @(c.ClubMember?.User?.Surname)</td>
                        <td>Wk @c.WeekNumber</td>
                        <td>@c.ContributionDate.ToString("yyyy-MM-dd")</td>
                        <td class="text-end fw-bold">R @c.Amount.ToString("N2")</td>
                        <td>
                            @if(c.Status == ContributionStatus.Paid) { <span class="badge bg-success">Paid</span> }
                            else { <span class="badge bg-warning text-dark">@c.Status</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>