@using StokSafe.Models.Enums
@model StokSafe.Models.Loan
@{ 
    ViewData["Title"] = $"Review LN-{Model.Id:D5}"; 
}

<div class="container mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">? Back to Loans</a>
    
    @if (TempData["Success"] is string success) { <div class="alert alert-success alert-dismissible fade show">@success <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger alert-dismissible fade show">@error <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Loan LN-@Model.Id.ToString("D5")</h4>
            <span class="badge bg-primary fs-6">@Model.Status</span>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Applicant</dt>
                <dd class="col-sm-9">@(Model.ClubMember?.User?.Name) @(Model.ClubMember?.User?.Surname) (@(Model.ClubMember?.User?.Email))</dd>
                
                <dt class="col-sm-3">Principal Requested</dt>
                <dd class="col-sm-9 fw-bold">R @Model.PrincipalAmount.ToString("N2")</dd>
                
                <dt class="col-sm-3">Date Requested</dt>
                <dd class="col-sm-9">@Model.RequestedAt.ToString("yyyy-MM-dd HH:mm")</dd>
            </dl>
        </div>
    </div>

    @if (Model.Status == LoanStatus.Pending)
    {
        <div class="row g-3">
            <!-- APPROVE PANEL -->
            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h5 class="text-info"><i class="bi bi-check-circle"></i> Approve</h5>
                        <p class="text-muted small">Approve this loan and set the interest rate. Funds will await disbursement.</p>
                        <form asp-action="Approve" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="mb-3">
                                <label class="form-label small">Interest Rate (%)</label>
                                <input type="number" name="interestRate" class="form-control" value="10" step="0.01" required />
                            </div>
                            <button type="submit" class="btn btn-info w-100">Approve Loan</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- DISBURSE PANEL -->
            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h5 class="text-success"><i class="bi bi-cash-coin"></i> Approve & Disburse</h5>
                        <p class="text-muted small">Immediately approve and hand over the funds to the member.</p>
                        <form asp-action="Disburse" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="mb-3">
                                <label class="form-label small">Payment Reference</label>
                                <input type="text" name="reference" class="form-control" placeholder="e.g. EFT-2026-001" />
                            </div>
                            <button type="submit" class="btn btn-success w-100">Disburse Funds</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- REJECT PANEL (UPDATED WITH DROPDOWN) -->
            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100 border-danger">
                    <div class="card-body">
                        <h5 class="text-danger"><i class="bi bi-x-circle"></i> Reject Loan</h5>
                        <p class="text-muted small">Deny this application based on the club's business rules.</p>
                        
                        <form asp-action="Reject" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            
                            <div class="mb-3">
                                <label class="form-label small">Rejection Reason</label>
                                <select name="reason" class="form-select" required>
                                    <option value="">-- Select a Reason --</option>
                                    <option value="Insufficient contribution history.">Insufficient contribution history</option>
                                    <option value="Exceeds maximum borrowing limit (50% of contributions).">Exceeds 50% borrowing limit</option>
                                    <option value="Member already has an active or pending loan.">Member has an active loan</option>
                                    <option value="Membership tenure is too short (must be 3+ months).">Membership tenure too short</option>
                                    <option value="Club treasury has insufficient funds.">Club funds insufficient</option>
                                    <option value="Application missing supporting documents.">Missing documents</option>
                                    <option value="Other (see notes).">Other (see notes)</option>
                                </select>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label small">Additional Notes (Optional)</label>
                                <textarea name="reason" class="form-control" rows="2" placeholder="Provide extra details..."></textarea>
                            </div>

                            <button type="submit" class="btn btn-outline-danger w-100">Reject Application</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (Model.Status == LoanStatus.Approved)
    {
        <div class="alert alert-info">
            <h5><i class="bi bi-hourglass-split"></i> Awaiting Disbursement</h5>
            <p class="mb-0">This loan is approved. Hand the cash/EFT to the member, then click Disburse.</p>
            <form asp-action="Disburse" method="post" class="mt-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="row g-2">
                    <div class="col-md-8">
                        <input type="text" name="reference" class="form-control" placeholder="Payment Reference" />
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-success w-100">Disburse Funds</button>
                    </div>
                </div>
            </form>
        </div>
    }
</div>