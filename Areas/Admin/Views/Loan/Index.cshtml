@using StokSafe.Models.Enums
@model IEnumerable<StokSafe.Models.Loan>
@{
    ViewData["Title"] = "Loan Applications";
    var pending = Model.Count(l => l.Status == LoanStatus.Pending);
}

<div class="container mt-4">
    <h1 class="fw-bold mb-4"><i class="bi bi-cash-stack"></i> Loan Applications</h1>

    @if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

    <div class="card shadow-sm border-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Ref</th><th>Member</th><th>Requested</th><th class="text-end">Amount</th><th>Status</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var loan in Model)
                {
                    <tr>
                        <td>LN-@loan.Id.ToString("D5")</td>
                        <td>@(loan.ClubMember?.User?.Name ?? "?") @(loan.ClubMember?.User?.Surname ?? "")</td>
                        <td>@loan.RequestedAt.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">R @loan.PrincipalAmount.ToString("N2")</td>
                        <td><span class="badge bg-primary">@loan.Status</span></td>
                        <td class="text-end"><a asp-action="Details" asp-route-id="@loan.Id" class="btn btn-sm btn-outline-primary">Review</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>