@using StokSafe.Models.Enums
@model IEnumerable<StokSafe.Models.Contribution>
@{
    ViewData["Title"] = "My Contributions";
    var pendingContribs = Model.Where(c => c.Status == ContributionStatus.Pending || c.Status == ContributionStatus.Failed).ToList();
    var totalPaid = Model.Where(c => c.Status == ContributionStatus.Paid).Sum(c => c.Amount);
    var totalPending = pendingContribs.Sum(c => c.Amount);
    bool isWindowOpen = ViewBag.IsWindowOpen ?? true;
}

<div class="container mt-4">
    
    <!-- PAYMENT WINDOW CLOSED ALERT -->
    @if (!isWindowOpen)
    {
        <div class="alert alert-danger shadow-sm border-start border-danger border-4 mb-4">
            <h5 class="alert-heading"><i class="bi bi-lock-fill"></i> Payment Window Closed</h5>
            <p class="mb-0">It is past 15:00 on Sunday. The weekly contribution window is now closed. You will be able to make payments again on Monday morning.</p>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold mb-0">My Contributions</h1>
        
        <!-- HIDE BUTTON IF WINDOW IS CLOSED -->
        @if (pendingContribs.Any() && isWindowOpen)
        {
            <button type="button" class="btn btn-success btn-lg" data-bs-toggle="modal" data-bs-target="#payContribModal">
                <i class="bi bi-wallet2"></i> Pay Contribution
            </button>
        }
    </div>

    @if (TempData["Success"] is string success) { <div class="alert alert-success alert-dismissible fade show">@success <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger alert-dismissible fade show">@error <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 border-start border-success border-4">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase small mb-2">Total Contributed</h6>
                    <h2 class="mb-0 text-success">R @totalPaid.ToString("N2")</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 border-start border-danger border-4">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase small mb-2">Outstanding</h6>
                    <h2 class="mb-0 text-danger">R @totalPending.ToString("N2")</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 border-start border-primary border-4">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase small mb-2">Records</h6>
                    <h2 class="mb-0">@Model.Count()</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Week</th>
                    <th class="text-end">Amount</th>
                    <th>Status</th>
                    <th>Due Date</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any()) { <tr><td colspan="6" class="text-center py-4 text-muted">No contribution records yet.</td></tr> }
                
                @foreach (var c in Model)
                {
                    var badgeClass = c.Status == ContributionStatus.Paid ? "bg-success" : "bg-warning text-dark";
                    <tr>
                        <td>@c.ContributionDate.ToString("yyyy-MM-dd")</td>
                        <td>@c.PaymentType</td>
                        <td>Week @c.WeekNumber</td>
                        <td class="text-end fw-bold">R @c.Amount.ToString("N2")</td>
                        <td><span class="badge @badgeClass">@c.Status</span></td>
                        <td>@c.DueDate.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL -->
@if (pendingContribs.Any() && isWindowOpen)
{
    <div class="modal fade" id="payContribModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="Pay" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-wallet2"></i> Pay Contribution</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Select Contribution Week</label>
                            <select id="contribDropdown" name="id" class="form-select" required>
                                <option value="" data-amount="0">-- Select an outstanding contribution --</option>
                                @foreach (var c in pendingContribs)
                                {
                                    <option value="@c.Id" data-amount="@c.Amount.ToString("F2")">
                                        Week @c.WeekNumber (Due: @c.DueDate.ToString("dd MMM")) - R @c.Amount.ToString("N2")
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Amount (R)</label>
                            <input type="number" step="0.01" min="1" name="amount" id="amountInput" class="form-control form-control-lg" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Reference (Optional)</label>
                            <input type="text" name="reference" class="form-control" placeholder="e.g. EFT-2026-001" />
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">Confirm Payment</button>
                    </div>
                </form>
            </div>
        </div>
    <a asp-action="PayCurrentWeek" class="btn btn-success btn-sm">
    <i class="bi bi-cash-coin"></i> Pay Weekly Contribution
</a>
</div>
    
    <script>
        document.getElementById('contribDropdown').addEventListener('change', function () {
            var selectedOption = this.options[this.selectedIndex];
            var amount = selectedOption.getAttribute('data-amount');
            var amountInput = document.getElementById('amountInput');
            
            if (amount && amount !== "0") {
                amountInput.value = amount;
            } else {
                amountInput.value = "";
            }
        });
    </script>
}