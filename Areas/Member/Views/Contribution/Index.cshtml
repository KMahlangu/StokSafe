@model IEnumerable<StokSafe.Models.Contribution>
@{
    ViewData["Title"] = "My Contributions";
}

<div class="container mt-4 mb-5">
    <h2 class="fw-bold mb-4">Weekly Contribution</h2>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (!Model.Any())
    {
        <div class="premium-card p-5 text-center">
            <h4 class="fw-bold">You are all caught up!</h4>
            <p class="text-muted-premium">There are no contributions due for the current week.</p>
        </div>
    }
    else
    {
        foreach (var item in Model)
        {
            <div class="premium-card p-4 mb-4">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <h4 class="fw-bold mb-1">Week @item.WeekNumber</h4>
                        <p class="text-muted-premium mb-0">Due: @item.DueDate.ToString("dddd, dd MMMM yyyy HH:mm")</p>
                    </div>
                    <div class="col-md-3 text-md-end">
                        <h3 class="fw-bold mb-0">R @item.Amount.ToString("N2")</h3>
                    </div>
                    <div class="col-md-3 text-md-end">
                        @if (item.Status == StokSafe.Models.Enums.ContributionStatus.Pending)
                        {
                            <a href="/Member/Contribution/Details/@item.Id" class="btn btn-accent w-100 py-2 shadow">Make Payment</a>
                        }
                        else
                        {
                            <span class="badge bg-success px-3 py-2 fs-6">@item.Status</span>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>