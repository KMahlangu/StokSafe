@using StokSafe.Models.Enums
@model StokSafe.Models.Contribution
@{
    ViewData["Title"] = $"Contribution Week {Model.WeekNumber}";
}

<div class="container mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">? Back to Contributions</a>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Contribution — Week @Model.WeekNumber</h4>
            <span class="badge bg-primary">@Model.Status</span>
        </div>
        <div class="card-body">
            <dl class="row mb-4">
                <dt class="col-sm-3">Amount</dt>
                <dd class="col-sm-9">R @Model.Amount.ToString("N2")</dd>

                <dt class="col-sm-3">Due Date</dt>
                <dd class="col-sm-9">@Model.DueDate.ToString("yyyy-MM-dd HH:mm")</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>
            </dl>

            @if (Model.Status == ContributionStatus.Pending)
            {
                <hr />
                <h5>Make Payment</h5>
                <!-- This form posts to the /Pay action we just created -->
                <form action="/Member/Contribution/Pay" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Amount (R)</label>
                            <input type="number" name="amount" step="0.01" min="@Model.Amount" value="@Model.Amount" class="form-control" readonly />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Reference (optional)</label>
                            <input type="text" name="reference" class="form-control" placeholder="e.g. EFT-WK01" />
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-success w-100">Pay R @Model.Amount.ToString("N2")</button>
                        </div>
                    </div>
                </form>
            }
            else if (Model.Status == ContributionStatus.Paid)
            {
                <div class="alert alert-success mb-0">
                    <i class="bi bi-check-circle-fill"></i>
                    Paid on @Model.PaidAt?.ToString("yyyy-MM-dd HH:mm").
                </div>
            }
        </div>
    </div>
</div>