@using StokSafe.Models.Enums
@model StokSafe.Models.Fine
@{
    ViewData["Title"] = $"Fine #{Model.Id}";
}

<div class="container mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">← Back to Fines</a>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
            <h4 class="mb-0">Fine #@Model.Id — @Model.FineType</h4>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>

                <dt class="col-sm-3">Original</dt>
                <dd class="col-sm-9">R @Model.OriginalAmount.ToString("N2")</dd>

                <dt class="col-sm-3">Current</dt>
                <dd class="col-sm-9">R @Model.CurrentAmount.ToString("N2")</dd>

                <dt class="col-sm-3">Paid</dt>
                <dd class="col-sm-9">R @Model.PaidAmount.ToString("N2")</dd>

                <dt class="col-sm-3">Balance</dt>
                <dd class="col-sm-9">R @Model.Balance.ToString("N2")</dd>

                <dt class="col-sm-3">Issued</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-3">Due</dt>
                <dd class="col-sm-9">@Model.DueDate.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <dt class="col-sm-3">Notes</dt>
                    <dd class="col-sm-9">@Model.Notes</dd>
                }
            </dl>
        </div>
    </div>
</div>