@using StokSafe.Models.Enums
@model StokSafe.Models.ViewModels.StatementViewModel
@{
    ViewData["Title"] = $"Statement — {Model.PeriodStart:MMM yyyy}";
    var availableMonths = ViewBag.AvailableMonths as IEnumerable<(int Year, int Month)>;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h1 class="fw-bold mb-0">
            Statement — @Model.PeriodStart.ToString("MMMM yyyy")
        </h1>

        <div class="d-flex gap-2">
            <form method="get" asp-action="Index" class="d-flex gap-2">
                <select name="month" class="form-select form-select-sm" style="width:auto;">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == Model.Month)">@(new DateTime(2024, m, 1).ToString("MMM"))</option>
                    }
                </select>
                <select name="year" class="form-select form-select-sm" style="width:auto;">
                    @for (int y = DateTime.UtcNow.Year; y >= DateTime.UtcNow.Year - 3; y--)
                    {
                        <option value="@y" selected="@(y == Model.Year)">@y</option>
                    }
                </select>
                <button type="submit" class="btn btn-sm btn-primary">View</button>
            </form>

            <form asp-action="SaveSnapshot" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="year" value="@Model.Year" />
                <input type="hidden" name="month" value="@Model.Month" />
                <button type="submit" class="btn btn-sm btn-outline-secondary">
                    Save Snapshot
                </button>
            </form>

            <button onclick="window.print()" class="btn btn-sm btn-outline-primary">
                Print
            </button>
            <form asp-action="EmailStatement" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="year" value="@Model.Year" />
                <input type="hidden" name="month" value="@Model.Month" />
                <button type="submit" class="btn btn-sm btn-outline-success">
                    <i class="bi bi-envelope"></i> Email Statement
                </button>
            </form>
        </div>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @success
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @error
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* ============ HEADER ============ *@
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h5 class="mb-1">@(Model.User.DisplayName ?? Model.User.Email)</h5>
                    <div class="text-muted small">@Model.User.Email</div>
                    @if (Model.Club is not null)
                    {
                        <div class="text-muted small">
                            Club: <strong>@Model.Club.Name</strong>
                        </div>
                    }
                </div>
                <div class="col-md-6 text-md-end">
                    <div class="text-muted small">
                        Statement period
                    </div>
                    <div class="fw-semibold">
                        @Model.PeriodStart.ToString("dd MMM yyyy")
                        &mdash;
                        @Model.PeriodEnd.ToString("dd MMM yyyy")
                    </div>
                    <div class="text-muted small mt-1">
                        Generated @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm")
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ============ SUMMARY ============ *@
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase small mb-2">Contributions Paid</h6>
                    <h3 class="mb-1 text-success">R @Model.ContributionsPaid.ToString("N2")</h3>
                    @if (Model.ContributionsPending > 0)
                    {
                        <small class="text-warning">
                            Pending: R @Model.ContributionsPending.ToString("N2")
                        </small>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase small mb-2">Fines Paid</h6>
                    <h3 class="mb-1">R @Model.FinesPaid.ToString("N2")</h3>
                    @if (Model.FinesOutstanding > 0)
                    {
                        <small class="text-danger">
                            Outstanding: R @Model.FinesOutstanding.ToString("N2")
                        </small>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase small mb-2">Loans Repaid</h6>
                    <h3 class="mb-1">R @Model.LoansRepaid.ToString("N2")</h3>
                    @if (Model.LoansOutstanding > 0)
                    {
                        <small class="text-warning">
                            Outstanding: R @Model.LoansOutstanding.ToString("N2")
                        </small>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase small mb-2">Net Position</h6>
                    <h3 class="mb-1">
                        <span class="@(Model.NetPosition >= 0 ? "text-success" : "text-danger")">
                            R @Model.NetPosition.ToString("N2")
                        </span>
                    </h3>
                    <small class="text-muted">Contributions − Fines − Loans repaid</small>
                </div>
            </div>
        </div>
    </div>

    @* ============ CONTRIBUTIONS ============ *@
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-header bg-white">
            <strong>Contributions</strong>
            <span class="badge bg-secondary">@Model.Contributions.Count</span>
        </div>
        <div class="card-body p-0">
            @if (Model.Contributions.Any())
            {
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Week</th>
                            <th class="text-end">Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Contributions)
                        {
                            var badge = c.Status switch
                            {
                                ContributionStatus.Paid    => "bg-success",
                                ContributionStatus.Pending => "bg-warning text-dark",
                                ContributionStatus.Failed  => "bg-danger",
                                _                          => "bg-secondary"
                            };
                            <tr>
                                <td>@c.ContributionDate.ToString("yyyy-MM-dd")</td>
                                <td>@c.PaymentType</td>
                                <td>@c.WeekNumber</td>
                                <td class="text-end">R @c.Amount.ToString("N2")</td>
                                <td><span class="badge @badge">@c.Status</span></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="3" class="text-end">Total paid</th>
                            <th class="text-end">R @Model.ContributionsPaid.ToString("N2")</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            }
            else
            {
                <p class="text-muted p-3 mb-0">No contributions in this period.</p>
            }
        </div>
    </div>

    @* ============ FINES ============ *@
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-header bg-white">
            <strong>Fines</strong>
            <span class="badge bg-secondary">@Model.Fines.Count</span>
        </div>
        <div class="card-body p-0">
            @if (Model.Fines.Any())
            {
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th class="text-end">Amount</th>
                            <th class="text-end">Paid</th>
                            <th class="text-end">Balance</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model.Fines)
                        {
                            var badge = f.Status switch
                            {
                                FineStatus.Paid          => "bg-success",
                                FineStatus.Pending       => "bg-warning text-dark",
                                FineStatus.Waived        => "bg-secondary",
                                FineStatus.Escalated     => "bg-danger",
                                FineStatus.PartiallyPaid => "bg-info text-dark",
                                _                        => "bg-light text-dark"
                            };
                            <tr>
                                <td>@f.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td>@f.FineType</td>
                                <td class="text-end">R @f.OriginalAmount.ToString("N2")</td>
                                <td class="text-end">R @f.PaidAmount.ToString("N2")</td>
                                <td class="text-end">R @f.Balance.ToString("N2")</td>
                                <td><span class="badge @badge">@f.Status</span></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="3" class="text-end">Total paid</th>
                            <th class="text-end">R @Model.FinesPaid.ToString("N2")</th>
                            <th colspan="2"></th>
                        </tr>
                    </tfoot>
                </table>
            }
            else
            {
                <p class="text-muted p-3 mb-0">No fines in this period. 🎉</p>
            }
        </div>
    </div>

    @* ============ LOANS ============ *@
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-header bg-white">
            <strong>Loans</strong>
            <span class="badge bg-secondary">@Model.Loans.Count</span>
        </div>
        <div class="card-body p-0">
            @if (Model.Loans.Any())
            {
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Ref</th>
                            <th>Requested</th>
                            <th class="text-end">Principal</th>
                            <th class="text-end">Outstanding</th>
                            <th>Status</th>
                            <th>Due</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.Loans)
                        {
                            var badge = l.Status switch
                            {
                                LoanStatus.Active    => "bg-primary",
                                LoanStatus.Overdue   => "bg-danger",
                                LoanStatus.Paid      => "bg-success",
                                LoanStatus.Pending   => "bg-warning text-dark",
                                LoanStatus.Approved  => "bg-info text-dark",
                                LoanStatus.Rejected  => "bg-secondary",
                                LoanStatus.Defaulted => "bg-dark",
                                _                    => "bg-light text-dark"
                            };
                            <tr>
                                <td>LN-@l.Id.ToString("D5")</td>
                                <td>@l.RequestedAt.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">R @l.PrincipalAmount.ToString("N2")</td>
                                <td class="text-end">R @l.OutstandingBalance.ToString("N2")</td>
                                <td><span class="badge @badge">@l.Status</span></td>
                                <td>@(l.DueDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted p-3 mb-0">No loans in this period.</p>
            }
        </div>
    </div>

    @* ============ LOAN PAYMENTS ============ *@
    @if (Model.LoanPayments.Any())
    {
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header bg-white">
                <strong>Loan Repayments</strong>
                <span class="badge bg-secondary">@Model.LoanPayments.Count</span>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Reference</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.LoanPayments)
                        {
                            <tr>
                                <td>@p.PaidAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@(string.IsNullOrWhiteSpace(p.Reference) ? "—" : p.Reference)</td>
                                <td class="text-end">R @p.Amount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="2" class="text-end">Total repaid</th>
                            <th class="text-end">R @Model.LoanPayments.Sum(p => p.Amount).ToString("N2")</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }

    <p class="text-muted small text-center mt-4">
        This statement is generated from your records on file. Discrepancies
        should be reported to the club secretary.
    </p>

</div>