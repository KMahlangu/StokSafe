@using StokSafe.Models.Enums
@model StokSafe.Models.Loan
@{ ViewData["Title"] = $"Loan LN-{Model.Id:D5}"; }

<div class="container mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">? Back</a>

    @if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white d-flex justify-content-between">
            <h4>Loan LN-@Model.Id.ToString("D5")</h4>
            <span class="badge bg-primary fs-6">@Model.Status</span>
        </div>
        <div class="card-body">
            <p><strong>Principal:</strong> R @Model.PrincipalAmount.ToString("N2")</p>
            <p><strong>Outstanding:</strong> R @Model.OutstandingBalance.ToString("N2")</p>
            <p><strong>Due Date:</strong> @(Model.DueDate?.ToString("yyyy-MM-dd") ?? "?")</p>

            @if (Model.Status == LoanStatus.Active || Model.Status == LoanStatus.Overdue)
            {
                <hr />
                <h5>Repay Loan</h5>
                <form asp-action="Pay" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="col-md-4">
                        <input type="number" step="0.01" min="0.01" max="@Model.OutstandingBalance" name="amount" class="form-control" placeholder="Amount" required />
                    </div>
                    <div class="col-md-4">
                        <input type="text" name="reference" class="form-control" placeholder="Reference" />
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-success w-100">Repay</button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>