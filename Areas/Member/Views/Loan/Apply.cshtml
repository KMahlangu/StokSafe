@{ ViewData["Title"] = "Apply for Loan"; }

<div class="container mt-4 mb-5">
    <div class="premium-card p-0 overflow-hidden mb-4">
        <div class="row g-0">
            <div class="col-md-5">
                <img src="https://images.unsplash.com/photo-1579532537598-459ecdaf39cc?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" 
                     class="img-fluid h-100 object-fit-cover" alt="Achieve your goals" style="object-fit: cover; min-height: 300px;" />
            </div>
            <div class="col-md-7 d-flex align-items-center">
                <div class="p-5">
                    <h2 class="fw-bold mb-3">Achieve your goals.</h2>
                    <p class="text-muted-premium">Whether it's for school fees, a small business, or an emergency, your stokvel is here to support you. Borrow up to 50% of what you've contributed.</p>
                    <ul class="list-unstyled text-muted-premium">
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i> No hidden interest rates</li>
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i> 4-week repayment window</li>
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i> Quick committee approval</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">? Back</a>

    @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white"><h4>Apply for a Loan</h4></div>
        <div class="card-body">
            <div class="alert alert-info small">
                <strong>Loan rules:</strong> Max 50% of contributions. Repayment within 4 weeks. 100% penalty if unpaid on time.
            </div>

            <form asp-action="Apply" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label">Principal Amount (R)</label>
                    <input type="number" step="0.01" min="50" name="principal" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Term (weeks)</label>
                    <input type="number" name="termMonths" class="form-control" value="4" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label">Reason</label>
                    <textarea name="reason" class="form-control" rows="2"></textarea>
                </div>
                <button type="submit" class="btn btn-success">Submit Application</button>
            </form>
        </div>
    </div>
</div>