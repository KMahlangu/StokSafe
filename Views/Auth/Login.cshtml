@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid p-0 mt-4 mb-5">
    <div class="row justify-content-center align-items-center" style="min-height: 70vh;">
        <!-- Left Side: The Image -->
        <div class="col-lg-6 d-none d-lg-block">
            <img src="https://images.unsplash.com/photo-1563986768609-322da13575f3?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80" 
                 class="img-fluid rounded-4 shadow-lg" style="object-fit: cover; height: 600px; width: 100%;" />
        </div>

        <!-- Right Side: The Form -->
        <div class="col-md-8 col-lg-5 ps-lg-5">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-5">
                    <h3 class="text-center fw-bold mb-4">Welcome Back</h3>
                    <p class="text-center text-muted-premium mb-4">Secure access to your stokvel.</p>
                    
                    @if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }

                    <form action="/Auth/Login" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Email Address</label>
                            <input type="email" name="email" class="form-control form-control-lg" placeholder="you@example.com" required />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Password</label>
                            <input type="password" name="password" class="form-control form-control-lg" placeholder="••••••••" required />
                        </div>
                        <button type="submit" class="btn btn-accent btn-lg w-100 mb-3">Log In</button>
                        <div class="text-center mt-3">
                            <a href="/Auth/ForgotPassword" class="text-muted-premium text-decoration-none">Forgot Password?</a>
                            <span class="text-muted mx-2">|</span>
                            <a href="/Auth/Register" class="text-accent fw-bold text-decoration-none">Join a Club</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>