<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StokSafe</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-custom">
        <div class="container">
            <!-- Brand -->
            <a class="navbar-brand fw-bold" style="color: white; font-size: 1.5rem;" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-shield-fill-check text-accent"></i> StokSafe
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    @if (User.Identity?.IsAuthenticated == true && (ViewContext.RouteData.Values["area"]?.ToString() == "Member" || ViewContext.RouteData.Values["area"]?.ToString() == "Admin"))
                    {
                        <!-- INTERNAL APP NAVIGATION (Only visible when logged in and inside Member/Admin area) -->
                        @if (User.IsInRole("Admin") || User.IsInRole("Head") || User.IsInRole("Treasurer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin Dashboard</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Member" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Member" asp-controller="Contribution" asp-action="Index">Contributions</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Member" asp-controller="Loan" asp-action="Index">Loans</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Member" asp-controller="Fine" asp-action="Index">Fines</a>
                        </li>
                    }
                    else
                    {
                        <!-- PUBLIC MARKETING NAVIGATION (Visible to everyone else) -->
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="About">Why Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Platform">Platform</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Pricing">Pricing</a>
                        </li>
                    }
                </ul>
                
                <!-- Right Side: Login/Register or User Profile -->
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer-premium mt-5">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5><i class="bi bi-shield-fill-check text-accent"></i> StokSafe</h5>
                    <p class="small text-muted">Modernizing South African stokvels. We provide a transparent, automated platform for community savings, loans, and fine management.</p>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h5>Platform</h5>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a asp-area="" asp-controller="Home" asp-action="Platform">Our Features</a></li>
                        <li class="mb-2"><a asp-area="" asp-controller="Home" asp-action="Pricing">Pricing</a></li>
                        <li class="mb-2"><a asp-area="" asp-controller="Home" asp-action="About">Why Us</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5>Compliance</h5>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="#">POPIA Privacy Policy</a></li>
                        <li class="mb-2"><a href="#">Terms of Service</a></li>
                        <li class="mb-2"><a href="#">NASASA Resources</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5>Support</h5>
                    <p class="small mb-1"><i class="bi bi-envelope me-2"></i> <a href="mailto:support@stoksafe.co.za">support@stoksafe.co.za</a></p>
                    <p class="small"><i class="bi bi-telephone me-2"></i> +27 (0) 10 123 4567</p>
                </div>
            </div>
            <hr style="border-color: #1A3B5C;" />
            <div class="text-center small text-muted">&copy; @DateTime.UtcNow.Year StokSafe. Built for the community.</div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>