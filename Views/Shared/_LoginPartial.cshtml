@using Microsoft.AspNetCore.Identity
@using StokSafe.Models
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

<ul class="navbar-nav ms-auto mb-2 mb-lg-0">
@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    var displayName = user?.DisplayName ?? "User";

    <li class="nav-item dropdown mt-2 mt-lg-0">
        <a class="nav-link dropdown-toggle text-white fw-bold" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-person-circle me-1"></i> @displayName
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow border-0">
            <li><a class="dropdown-item" asp-area="Member" asp-controller="Manage" asp-action="Index">My Profile</a></li>
            @if (User.IsInRole("Admin") || User.IsInRole("Head") || User.IsInRole("Treasurer"))
            {
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin Dashboard</a></li>
                <li><a class="dropdown-item" asp-area="Admin" asp-controller="User" asp-action="Index">Manage Users</a></li>
            }
            <li><hr class="dropdown-divider"></li>
            <li>
                <form class="form-inline" asp-area="" asp-controller="Auth" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="dropdown-item text-danger">Logout</button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item mt-2 mt-lg-0">
        <a class="nav-link text-white fw-bold" asp-area="" asp-controller="Auth" asp-action="Login">Login</a>
    </li>
    <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
        <a class="btn btn-accent w-100 w-lg-auto px-4 py-2" asp-area="" asp-controller="Auth" asp-action="Register">Register</a>
    </li>
}
</ul>